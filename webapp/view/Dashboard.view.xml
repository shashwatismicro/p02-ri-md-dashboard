<mvc:View
    controllerName="com.oswal.managementcockpit.managementcockpit.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">

    <Page
        id="page"
        class="sapUiContentPadding">

        <content>
            <VBox
                id="managementCockpitContent"
                width="100%">

                <HBox
                    id="dashboardHeader"
                    width="100%"
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                    class="sapUiSmallMarginBottom">

                    <VBox id="dashboardHeaderText">
                        <Title
                            id="dashboardMainTitle"
                            text="Director Dashboard"
                            level="H1" />

                        <Text
                            id="dashboardCompanyText"
                            text="Company Code: OCPL (Oswal Castings Pvt Ltd)"
                            class="sapUiTinyMarginTop" />
                    </VBox>

                    <ObjectStatus
                        id="prototypeModeStatus"
                        text="Prototype Mode"
                        state="Information"
                        icon="sap-icon://information" />
                </HBox>

                <IconTabBar
                    id="managementCockpitTabs"
                    selectedKey="executiveOverview"
                    expandable="false"
                    stretchContentHeight="false"
                    select=".onManagementTabSelect"
                    class="sapUiResponsiveContentPadding">

                    <items>

                        <!-- Executive Overview -->
                        <IconTabFilter
                            id="executiveOverviewTab"
                            key="executiveOverview"
                            text="Executive Overview">

                            <VBox
                                id="executiveOverviewContent"
                                class="sapUiMediumMarginTop">

                                <!-- Global Filter Bar -->
                                <HBox
                                    id="dashboardFilterBar"
                                    width="100%"
                                    wrap="Wrap"
                                    justifyContent="End"
                                    alignItems="End"
                                    class="sapUiSmallMarginBottom">

                                    <VBox
                                        id="companyCodeFilterBox"
                                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom">

                                        <Label
                                            id="companyCodeLabel"
                                            text="Company Code"
                                            labelFor="companyCodeSelect" />

                                        <Select
                                            id="companyCodeSelect"
                                            width="9rem"
                                            selectedKey="OCPL">

                                            <items>
                                                <core:Item
                                                    id="companyCodeOCPL"
                                                    key="OCPL"
                                                    text="OCPL" />
                                            </items>
                                        </Select>
                                    </VBox>

                                    <VBox
                                        id="plantFilterBox"
                                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom">

                                        <Label
                                            id="plantLabel"
                                            text="Plant"
                                            labelFor="plantSelect" />

                                        <Select
                                            id="plantSelect"
                                            width="9rem"
                                            selectedKey="ALL">

                                            <items>
                                                <core:Item
                                                    id="plantAll"
                                                    key="ALL"
                                                    text="All" />

                                                <core:Item
                                                    id="plantOC01"
                                                    key="OC01"
                                                    text="OC01" />

                                                <core:Item
                                                    id="plantOC02"
                                                    key="OC02"
                                                    text="OC02" />

                                                <core:Item
                                                    id="plantOC03"
                                                    key="OC03"
                                                    text="OC03" />
                                            </items>
                                        </Select>
                                    </VBox>

                                    <VBox
                                        id="fiscalYearFilterBox"
                                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom">

                                        <Label
                                            id="fiscalYearLabel"
                                            text="Fiscal Year"
                                            labelFor="fiscalYearSelect" />

                                        <Select
                                            id="fiscalYearSelect"
                                            width="9rem"
                                            selectedKey="2026">

                                            <items>
                                                <core:Item
                                                    id="fiscalYear2026"
                                                    key="2026"
                                                    text="2026" />

                                                <core:Item
                                                    id="fiscalYear2025"
                                                    key="2025"
                                                    text="2025" />

                                                <core:Item
                                                    id="fiscalYear2024"
                                                    key="2024"
                                                    text="2024" />
                                            </items>
                                        </Select>
                                    </VBox>

                                    <VBox
                                        id="periodFilterBox"
                                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom">

                                        <Label
                                            id="periodLabel"
                                            text="Period"
                                            labelFor="periodSelect" />

                                        <Select
                                            id="periodSelect"
                                            width="9rem"
                                            selectedKey="08">

                                            <items>
                                                <core:Item id="periodAll" key="ALL" text="All" />
                                                <core:Item id="periodApr" key="04" text="Apr" />
                                                <core:Item id="periodMay" key="05" text="May" />
                                                <core:Item id="periodJun" key="06" text="Jun" />
                                                <core:Item id="periodJul" key="07" text="Jul" />
                                                <core:Item id="periodAug" key="08" text="Aug" />
                                                <core:Item id="periodSep" key="09" text="Sep" />
                                                <core:Item id="periodOct" key="10" text="Oct" />
                                                <core:Item id="periodNov" key="11" text="Nov" />
                                                <core:Item id="periodDec" key="12" text="Dec" />
                                                <core:Item id="periodJan" key="01" text="Jan" />
                                                <core:Item id="periodFeb" key="02" text="Feb" />
                                                <core:Item id="periodMar" key="03" text="Mar" />
                                            </items>
                                        </Select>
                                    </VBox>

                                    <Button
                                        id="applyFiltersButton"
                                        text="Go"
                                        type="Emphasized"
                                        width="5rem"
                                        press=".onApplyFilters"
                                        class="sapUiTinyMarginBottom" />
                                </HBox>

                                <!-- KPI Cards -->
                                <HBox
                                    id="kpiCardRow"
                                    width="100%"
                                    wrap="Wrap"
                                    justifyContent="SpaceBetween"
                                    class="sapUiSmallMarginTop">

                                    <VBox
                                        id="totalSalesCard"
                                        width="24%"
                                        class="sapUiContentPadding sapUiTinyMarginBottom sapUiShadowLevel1">

                                        <HBox
                                            id="totalSalesCardHeader"
                                            alignItems="Center">

                                            <core:Icon
                                                id="totalSalesIcon"
                                                src="sap-icon://sales-order"
                                                size="1.5rem"
                                                color="#0a6ed1"
                                                class="sapUiTinyMarginEnd" />

                                            <Text
                                                id="totalSalesLabel"
                                                text="Total Sales" />
                                        </HBox>

                                        <ObjectNumber
                                            id="totalSalesValue"
                                            number="1,245.67"
                                            unit="MT"
                                            emphasized="true"
                                            class="sapUiSmallMarginTop" />

                                        <ObjectStatus
                                            id="totalSalesStatus"
                                            text="Demonstration value"
                                            state="Information"
                                            class="sapUiTinyMarginTop" />
                                    </VBox>

                                    <VBox
                                        id="totalRevenueCard"
                                        width="24%"
                                        class="sapUiContentPadding sapUiTinyMarginBottom sapUiShadowLevel1">

                                        <HBox
                                            id="totalRevenueCardHeader"
                                            alignItems="Center">

                                            <core:Icon
                                                id="totalRevenueIcon"
                                                src="sap-icon://money-bills"
                                                size="1.5rem"
                                                color="#0a6ed1"
                                                class="sapUiTinyMarginEnd" />

                                            <Text
                                                id="totalRevenueLabel"
                                                text="Total Revenue" />
                                        </HBox>

                                        <ObjectNumber
                                            id="totalRevenueValue"
                                            number="₹ 125.4"
                                            unit="Cr"
                                            emphasized="true"
                                            class="sapUiSmallMarginTop" />

                                        <ObjectStatus
                                            id="totalRevenueStatus"
                                            text="Demonstration value"
                                            state="Information"
                                            class="sapUiTinyMarginTop" />
                                    </VBox>

                                    <VBox
                                        id="accountsReceivableCard"
                                        width="24%"
                                        class="sapUiContentPadding sapUiTinyMarginBottom sapUiShadowLevel1">

                                        <HBox
                                            id="accountsReceivableCardHeader"
                                            alignItems="Center">

                                            <core:Icon
                                                id="accountsReceivableIcon"
                                                src="sap-icon://customer-financial-fact-sheet"
                                                size="1.5rem"
                                                color="#0a6ed1"
                                                class="sapUiTinyMarginEnd" />

                                            <Text
                                                id="accountsReceivableLabel"
                                                text="Accounts Receivable" />
                                        </HBox>

                                        <ObjectNumber
                                            id="accountsReceivableValue"
                                            number="₹ 32.6"
                                            unit="Cr"
                                            emphasized="true"
                                            class="sapUiSmallMarginTop" />

                                        <ObjectStatus
                                            id="accountsReceivableStatus"
                                            text="All historical outstanding items"
                                            state="Information"
                                            class="sapUiTinyMarginTop" />
                                    </VBox>

                                    <VBox
                                        id="accountsPayableCard"
                                        width="24%"
                                        class="sapUiContentPadding sapUiTinyMarginBottom sapUiShadowLevel1">

                                        <HBox
                                            id="accountsPayableCardHeader"
                                            alignItems="Center">

                                            <core:Icon
                                                id="accountsPayableIcon"
                                                src="sap-icon://supplier"
                                                size="1.5rem"
                                                color="#0a6ed1"
                                                class="sapUiTinyMarginEnd" />

                                            <Text
                                                id="accountsPayableLabel"
                                                text="Accounts Payable" />
                                        </HBox>

                                        <ObjectNumber
                                            id="accountsPayableValue"
                                            number="₹ 21.8"
                                            unit="Cr"
                                            emphasized="true"
                                            class="sapUiSmallMarginTop" />

                                        <ObjectStatus
                                            id="accountsPayableStatus"
                                            text="All historical outstanding items"
                                            state="Information"
                                            class="sapUiTinyMarginTop" />
                                    </VBox>
                                </HBox>

                                <!-- Top Customer Charts -->
<HBox
    id="customerChartRow"
    width="100%"
    wrap="Wrap"
    justifyContent="SpaceBetween"
    class="sapUiSmallMarginTop">

    <!-- Top 4 Customers by Sales -->
    <VBox
        id="topCustomersSalesPanel"
        width="49%"
        class="sapUiContentPadding sapUiTinyMarginBottom sapUiShadowLevel1">

        <HBox
            id="topCustomersSalesHeader"
            width="100%"
            justifyContent="SpaceBetween"
            alignItems="Center"
            class="sapUiSmallMarginBottom">

            <Title
                id="topCustomersSalesTitle"
                text="Top 4 Customers by Total Sales"
                level="H3" />

            <ObjectStatus
                id="topCustomersSalesDemoStatus"
                text="Loading"
                state="Information" />
        </HBox>

        <viz:VizFrame
            id="topCustomersSalesChart"
            width="100%"
            height="20rem"
            vizType="bar"
            uiConfig="{applicationSet:'fiori'}">

            <viz:dataset>
                <viz.data:FlattenedDataset
                    id="topCustomersSalesDataset"
                    data="{topSales>/customers}">

                    <viz.data:dimensions>
                        <viz.data:DimensionDefinition
                            id="topCustomersSalesCustomerDimension"
                            name="Customer"
                            value="{topSales>customerDisplay}" />
                    </viz.data:dimensions>

                    <viz.data:measures>
                        <viz.data:MeasureDefinition
                            id="topCustomersSalesMeasure"
                            name="Sales"
                            value="{topSales>salesMT}" />
                    </viz.data:measures>
                </viz.data:FlattenedDataset>
            </viz:dataset>

            <viz:feeds>
                <viz.feeds:FeedItem
                    id="topCustomersSalesValueFeed"
                    uid="valueAxis"
                    type="Measure"
                    values="Sales" />

                <viz.feeds:FeedItem
                    id="topCustomersSalesCategoryFeed"
                    uid="categoryAxis"
                    type="Dimension"
                    values="Customer" />
            </viz:feeds>
        </viz:VizFrame>
    </VBox>

    <!-- Top 4 Customers by Revenue -->
    <VBox
        id="topCustomersRevenuePanel"
        width="49%"
        class="sapUiContentPadding sapUiTinyMarginBottom sapUiShadowLevel1">

        <HBox
            id="topCustomersRevenueHeader"
            width="100%"
            justifyContent="SpaceBetween"
            alignItems="Center"
            class="sapUiSmallMarginBottom">

            <Title
                id="topCustomersRevenueTitle"
                text="Top 4 Customers by Total Revenue"
                level="H3" />

            <ObjectStatus
                id="topCustomersRevenueDemoStatus"
                text="Loading"
                state="Information" />
        </HBox>

        <viz:VizFrame
            id="topCustomersRevenueChart"
            width="100%"
            height="20rem"
            vizType="bar"
            uiConfig="{applicationSet:'fiori'}">

            <viz:dataset>
                <viz.data:FlattenedDataset
                    id="topCustomersRevenueDataset"
                    data="{topRevenue>/customers}">

                    <viz.data:dimensions>
                        <viz.data:DimensionDefinition
                            id="topCustomersRevenueCustomerDimension"
                            name="Customer"
                            value="{topRevenue>customerDisplay}" />
                    </viz.data:dimensions>

                    <viz.data:measures>
                        <viz.data:MeasureDefinition
                            id="topCustomersRevenueMeasure"
                            name="Revenue"
                            value="{topRevenue>revenueCr}" />
                    </viz.data:measures>
                </viz.data:FlattenedDataset>
            </viz:dataset>

            <viz:feeds>
                <viz.feeds:FeedItem
                    id="topCustomersRevenueValueFeed"
                    uid="valueAxis"
                    type="Measure"
                    values="Revenue" />

                <viz.feeds:FeedItem
                    id="topCustomersRevenueCategoryFeed"
                    uid="categoryAxis"
                    type="Dimension"
                    values="Customer" />
            </viz:feeds>
        </viz:VizFrame>
    </VBox>
</HBox>

<!-- Receivables, Payables and Revenue Split Doughnut Charts -->
<HBox
    id="ageingChartRow"
    width="100%"
    wrap="Wrap"
    justifyContent="SpaceBetween"
    alignItems="Stretch"
    class="sapUiSmallMarginTop">

    <!-- Receivables Ageing -->
    <VBox
        id="receivablesAgeingPanel"
        class="sapUiContentPadding sapUiTinyMarginBottom sapUiShadowLevel1">

        <HBox
            id="receivablesAgeingHeader"
            width="100%"
            justifyContent="SpaceBetween"
            alignItems="Center"
            class="sapUiSmallMarginBottom">

            <Title
                id="receivablesAgeingTitle"
                text="Receivables Ageing"
                level="H3" />

            <ObjectStatus
                id="receivablesAgeingStatus"
                text="Bill count by Due Days"
                state="Information" />
        </HBox>

        <VBox
            id="receivablesAgeingChartContainer"
            width="100%"
            alignItems="Stretch"
            class="ageingDonutContainer">

            <viz:VizFrame
                id="receivablesAgeingChart"
                width="100%"
                height="20rem"
                vizType="donut"
                uiConfig="{applicationSet:'fiori'}"
                class="ageingDonutChart">

                <viz:dataset>
                    <viz.data:FlattenedDataset
                        id="receivablesAgeingDataset"
                        data="{receivablesAgeing>/buckets}">

                        <viz.data:dimensions>
                            <viz.data:DimensionDefinition
                                id="receivablesAgeingSlabDimension"
                                name="Due Days"
                                value="{receivablesAgeing>legendText}" />
                        </viz.data:dimensions>

                        <viz.data:measures>
                            <viz.data:MeasureDefinition
                                id="receivablesAgeingBillCountMeasure"
                                name="Bills"
                                value="{receivablesAgeing>billCount}" />
                        </viz.data:measures>
                    </viz.data:FlattenedDataset>
                </viz:dataset>

                <viz:feeds>
                    <viz.feeds:FeedItem
                        id="receivablesAgeingSizeFeed"
                        uid="size"
                        type="Measure"
                        values="Bills" />

                    <viz.feeds:FeedItem
                        id="receivablesAgeingColorFeed"
                        uid="color"
                        type="Dimension"
                        values="Due Days" />
                </viz:feeds>
            </viz:VizFrame>

            <VBox
                id="receivablesAgeingCenterContent"
                alignItems="Center"
                justifyContent="Center"
                class="ageingDonutCenterContent">

                <ObjectNumber
                    id="receivablesAgeingTotalValue"
                    number="{receivablesAgeing>/totalAmountCr}"
                    unit="Cr"
                    emphasized="true" />

                <Text
                    id="receivablesAgeingTotalLabel"
                    text="{receivablesAgeing>/totalLabel}"
                    textAlign="Center"
                    class="sapUiTinyMarginTop" />
            </VBox>
        </VBox>
    </VBox>

    <!-- Payables Ageing -->
    <VBox
        id="payablesAgeingPanel"
        class="sapUiContentPadding sapUiTinyMarginBottom sapUiShadowLevel1">

        <HBox
            id="payablesAgeingHeader"
            width="100%"
            justifyContent="SpaceBetween"
            alignItems="Center"
            class="sapUiSmallMarginBottom">

            <Title
                id="payablesAgeingTitle"
                text="Payables Ageing"
                level="H3" />

            <ObjectStatus
                id="payablesAgeingStatus"
                text="Bill count by Due Days"
                state="Information" />
        </HBox>

        <VBox
            id="payablesAgeingChartContainer"
            width="100%"
            alignItems="Stretch"
            class="ageingDonutContainer">

            <viz:VizFrame
                id="payablesAgeingChart"
                width="100%"
                height="20rem"
                vizType="donut"
                uiConfig="{applicationSet:'fiori'}"
                class="ageingDonutChart">

                <viz:dataset>
                    <viz.data:FlattenedDataset
                        id="payablesAgeingDataset"
                        data="{payablesAgeing>/buckets}">

                        <viz.data:dimensions>
                            <viz.data:DimensionDefinition
                                id="payablesAgeingSlabDimension"
                                name="Due Days"
                                value="{payablesAgeing>legendText}" />
                        </viz.data:dimensions>

                        <viz.data:measures>
                            <viz.data:MeasureDefinition
                                id="payablesAgeingBillCountMeasure"
                                name="Bills"
                                value="{payablesAgeing>billCount}" />
                        </viz.data:measures>
                    </viz.data:FlattenedDataset>
                </viz:dataset>

                <viz:feeds>
                    <viz.feeds:FeedItem
                        id="payablesAgeingSizeFeed"
                        uid="size"
                        type="Measure"
                        values="Bills" />

                    <viz.feeds:FeedItem
                        id="payablesAgeingColorFeed"
                        uid="color"
                        type="Dimension"
                        values="Due Days" />
                </viz:feeds>
            </viz:VizFrame>

            <VBox
                id="payablesAgeingCenterContent"
                alignItems="Center"
                justifyContent="Center"
                class="ageingDonutCenterContent">

                <ObjectNumber
                    id="payablesAgeingTotalValue"
                    number="{payablesAgeing>/totalAmountCr}"
                    unit="Cr"
                    emphasized="true" />

                <Text
                    id="payablesAgeingTotalLabel"
                    text="{payablesAgeing>/totalLabel}"
                    textAlign="Center"
                    class="sapUiTinyMarginTop" />
            </VBox>
        </VBox>
    </VBox>

    <!-- Export and Domestic Revenue -->
    <VBox
        id="exportDomesticRevenuePanel"
        class="sapUiContentPadding sapUiTinyMarginBottom sapUiShadowLevel1">

        <HBox
            id="exportDomesticRevenueHeader"
            width="100%"
            justifyContent="SpaceBetween"
            alignItems="Center"
            class="sapUiSmallMarginBottom">

            <Title
                id="exportDomesticRevenueTitle"
                text="Export and Domestic Revenue"
                level="H3" />

            <ObjectStatus
                id="exportDomesticRevenueStatus"
                text="Revenue split"
                state="Information" />
        </HBox>

        <VBox
            id="exportDomesticRevenueChartContainer"
            width="100%"
            alignItems="Stretch"
            class="ageingDonutContainer">

            <viz:VizFrame
                id="exportDomesticRevenueChart"
                width="100%"
                height="20rem"
                vizType="donut"
                uiConfig="{applicationSet:'fiori'}"
                class="ageingDonutChart">

                <viz:dataset>
                    <viz.data:FlattenedDataset
                        id="exportDomesticRevenueDataset"
                        data="{exportDomesticRevenue>/segments}">

                        <viz.data:dimensions>
                            <viz.data:DimensionDefinition
                                id="exportDomesticRevenueCategoryDimension"
                                name="Revenue Type"
                                value="{exportDomesticRevenue>category}" />
                        </viz.data:dimensions>

                        <viz.data:measures>
                            <viz.data:MeasureDefinition
                                id="exportDomesticRevenueMeasure"
                                name="Revenue"
                                value="{exportDomesticRevenue>revenueCr}" />
                        </viz.data:measures>
                    </viz.data:FlattenedDataset>
                </viz:dataset>

                <viz:feeds>
                    <viz.feeds:FeedItem
                        id="exportDomesticRevenueSizeFeed"
                        uid="size"
                        type="Measure"
                        values="Revenue" />

                    <viz.feeds:FeedItem
                        id="exportDomesticRevenueColorFeed"
                        uid="color"
                        type="Dimension"
                        values="Revenue Type" />
                </viz:feeds>
            </viz:VizFrame>

            <VBox
                id="exportDomesticRevenueCenterContent"
                alignItems="Center"
                justifyContent="Center"
                class="ageingDonutCenterContent">

                <ObjectNumber
                    id="exportDomesticRevenueTotalValue"
                    number="{exportDomesticRevenue>/totalAmountCr}"
                    unit="Cr"
                    emphasized="true" />

                <Text
                    id="exportDomesticRevenueTotalLabel"
                    text="{exportDomesticRevenue>/totalLabel}"
                    textAlign="Center"
                    class="sapUiTinyMarginTop" />
            </VBox>
        </VBox>
    </VBox>
</HBox>

                                <!-- Month-wise Revenue Chart -->
<VBox
    id="monthlyRevenuePanel"
    width="100%"
    class="sapUiContentPadding sapUiSmallMarginTop sapUiShadowLevel1">

    <HBox
        id="monthlyRevenueHeader"
        width="100%"
        justifyContent="SpaceBetween"
        alignItems="Center"
        class="sapUiSmallMarginBottom">

        <Title
            id="monthlyRevenueTitle"
            text="Month-wise Total Revenue"
            level="H3" />

        <ObjectStatus
            id="monthlyRevenueDemoStatus"
            text="Loading"
            state="Information" />
    </HBox>

    <viz:VizFrame
        id="monthlyRevenueChart"
        width="100%"
        height="24rem"
        vizType="column"
        uiConfig="{applicationSet:'fiori'}">

        <viz:dataset>
            <viz.data:FlattenedDataset
                id="monthlyRevenueDataset"
                data="{monthlyRevenue>/months}">

                <viz.data:dimensions>
                    <viz.data:DimensionDefinition
                        id="monthlyRevenueMonthDimension"
                        name="Month"
                        value="{monthlyRevenue>monthLabel}" />
                </viz.data:dimensions>

                <viz.data:measures>
                    <viz.data:MeasureDefinition
                        id="monthlyRevenueMeasure"
                        name="Revenue"
                        value="{monthlyRevenue>revenueCr}" />
                </viz.data:measures>

            </viz.data:FlattenedDataset>
        </viz:dataset>

        <viz:feeds>
            <viz.feeds:FeedItem
                id="monthlyRevenueValueFeed"
                uid="valueAxis"
                type="Measure"
                values="Revenue" />

            <viz.feeds:FeedItem
                id="monthlyRevenueCategoryFeed"
                uid="categoryAxis"
                type="Dimension"
                values="Month" />
        </viz:feeds>

    </viz:VizFrame>
</VBox>

                            </VBox>
                        </IconTabFilter>

                        <!-- Finance -->
                        <IconTabFilter
